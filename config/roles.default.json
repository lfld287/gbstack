{
  "schemaVersion": 2,
  "roles": {
    "coordinator": {
      "description": "Top-level Swarm coordinator for task breakdown, dispatch, verification, and Git commits.",
      "prompt": null,
      "readonly": false,
      "workspace": "main",
      "mode": "native",
      "native": {
        "provider": "google",
        "model": "gemini-4-hydrogen-high",
        "lowQuotaFallback": null
      },
      "cli": null
    },
    "scout": {
      "description": "Strictly read-only local and remote reconnaissance, diagnosis, research, and baseline collection.",
      "prompt": "scout.md",
      "readonly": true,
      "workspace": "inherit",
      "mode": "native",
      "native": {
        "provider": "google",
        "model": "gemini-4-hydrogen-medium",
        "lowQuotaFallback": null
      },
      "cli": null
    },
    "plan": {
      "description": "Read-only software architect for exploration and implementation planning.",
      "prompt": "plan.md",
      "readonly": true,
      "workspace": "inherit",
      "mode": "native",
      "native": {
        "provider": "google",
        "model": "gemini-4-neon-xhigh",
        "lowQuotaFallback": "claude-opus-5-5-high"
      },
      "cli": null
    },
    "worker": {
      "description": "Implementation and state-modifying agent (code, diagnostics, benchmarks, scripts) supporting CLI and Native modes.",
      "prompt": "worker.md",
      "readonly": false,
      "workspace": "inherit",
      "concurrentWorkspace": "share",
      "mode": "cli",
      "native": {
        "provider": "google",
        "model": "gemini-4-hydrogen-high",
        "reworkModel": "gemini-4-neon-high",
        "lowQuotaFallback": "claude-sonnet-5-5-high"
      },
      "cli": {
        "provider": "openai",
        "binary": "codex",
        "fallbackBinaries": ["~/.local/bin/codex"],
        "args": [
          "exec",
          "--ephemeral",
          "--color",
          "never",
          "-m",
          "gpt-6.2-sol",
          "-c",
          "model_reasoning_effort=\"high\"",
          "-c",
          "approval_policy=\"never\"",
          "-s",
          "workspace-write",
          "-C",
          "{workdir}"
        ],
        "nonGitArgs": ["--skip-git-repo-check"],
        "extraDirArgs": ["--add-dir", "{dir}"],
        "promptInput": "stdin",
        "stdinArg": "-",
        "timeoutSeconds": 600,
        "preflight": {
          "command": [
            "sh",
            "-c",
            "h=\"${CODEX_HOME:-$HOME/.codex}\"; g=$(cd -- \"$h\" 2>/dev/null && pwd -P || printf '%s' \"$h\"); CODEX_HOME=\"$h\" TMPDIR=\"$g\" \"$1\" login status",
            "_",
            "{binary}"
          ],
          "outputContains": "Logged in"
        },
        "outerModel": "gemini-3.8-flash-medium",
        "outerLowQuotaFallback": "claude-sonnet-5-5-high",
        "fallbackToNativeOnPreflightFail": true,
        "fallbackToNativeOnTransientFailure": true,
        "rework": null,
        "fallback": null
      }
    },
    "reviewer-gemini": {
      "description": "Read-only code and design reviewer running on Google Native.",
      "prompt": "reviewer.md",
      "readonly": true,
      "workspace": "inherit",
      "mode": "native",
      "native": {
        "provider": "google",
        "model": "gemini-4-neon-xhigh",
        "lowQuotaFallback": null
      },
      "cli": null
    },
    "reviewer-claude": {
      "description": "Read-only code and design reviewer running on Claude Native.",
      "prompt": "reviewer.md",
      "readonly": true,
      "workspace": "inherit",
      "mode": "native",
      "native": {
        "provider": "anthropic",
        "model": "claude-opus-5-5-high",
        "lowQuotaFallback": null
      },
      "cli": null
    },
    "reviewer-codex": {
      "description": "Read-only code and design reviewer backed by Codex CLI.",
      "prompt": "reviewer.md",
      "readonly": true,
      "workspace": "inherit",
      "mode": "cli",
      "native": null,
      "cli": {
        "provider": "openai",
        "binary": "codex",
        "fallbackBinaries": ["~/.local/bin/codex"],
        "args": [
          "exec",
          "--ephemeral",
          "--color",
          "never",
          "-m",
          "gpt-6.2-astra",
          "-c",
          "model_reasoning_effort=\"xhigh\"",
          "-c",
          "approval_policy=\"never\"",
          "-c",
          "mcp_servers.node_repl.enabled=false",
          "-s",
          "read-only",
          "-C",
          "{workdir}"
        ],
        "nonGitArgs": ["--skip-git-repo-check"],
        "promptInput": "stdin",
        "stdinArg": "-",
        "timeoutSeconds": 600,
        "preflight": {
          "command": [
            "sh",
            "-c",
            "h=\"${CODEX_HOME:-$HOME/.codex}\"; g=$(cd -- \"$h\" 2>/dev/null && pwd -P || printf '%s' \"$h\"); CODEX_HOME=\"$h\" TMPDIR=\"$g\" \"$1\" login status",
            "_",
            "{binary}"
          ],
          "outputContains": "Logged in"
        },
        "outerModel": "gemini-3.8-flash-medium",
        "outerLowQuotaFallback": "claude-sonnet-5-5-high",
        "fallbackToNativeOnPreflightFail": false,
        "fallbackToNativeOnTransientFailure": false,
        "rework": null,
        "fallback": null
      }
    },
    "monitor": {
      "description": "Optional Swarm stall monitor powered by built-in swarm_monitor skill.",
      "prompt": null,
      "skill": "swarm_monitor",
      "readonly": true,
      "workspace": "inherit",
      "mode": "native",
      "native": {
        "provider": "google",
        "model": "gemini-3.8-flash-low",
        "lowQuotaFallback": null
      },
      "cli": null
    }
  },
  "reviews": {
    "default": {
      "description": "Dual Native heterogeneous cross-review for Review Gate, pr-review, and interrogate.",
      "members": ["reviewer-gemini", "reviewer-claude"],
      "requireDistinctProviders": true,
      "minDistinctProviders": 2,
      "allowSameProviderFallback": false,
      "onMissingProvider": "mark-incomplete",
      "onIncomplete": "mark-incomplete"
    },
    "council": {
      "description": "Three-provider heterogeneous iterative review panel for explicit /council.",
      "members": ["reviewer-codex", "reviewer-gemini", "reviewer-claude"],
      "requireDistinctProviders": true,
      "minDistinctProviders": 3,
      "allowSameProviderFallback": false,
      "onMissingProvider": "block",
      "onIncomplete": "block",
      "maxRounds": 3
    }
  },
  "slots": {
    "coordinator": "coordinator",
    "recon": "scout",
    "plan": "plan",
    "implement": "worker",
    "monitor": "monitor",
    "review": "default",
    "interrogate": "default",
    "council": "council"
  }
}
